[Unit]
Description=ERMS bounded disposition eligibility evaluation
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=erms
Group=erms
WorkingDirectory=/opt/erms
EnvironmentFile=/etc/erms/api.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/erms/backend/services/api/.venv/bin/python -m backend.services.api.disposition.eligibility --watch --batch-size 100 --interval-seconds 60
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077

[Install]
WantedBy=multi-user.target
