[
  {
    "module": "global_search",
    "factory": "build_global_search",
    "functions": [
      "global_search_payload",
      "render_safe_snippet",
      "copy_diagnostic_json",
      "render_search_diagnostics",
      "render_global_search_results",
      "change_global_search_page",
      "remember_global_result",
      "set_global_result_expansion",
      "open_global_record_from_result",
      "open_global_aggregation_from_result",
      "open_global_record",
      "open_global_aggregation",
      "run_global_search",
      "clear_global_search_session"
    ],
    "dependencies": [
      "add_button",
      "add_record_button",
      "aggregation_mode_bar",
      "api",
      "clear_advanced_workspace",
      "clear_collection_results",
      "discard_navigation_guard",
      "enter_global_search",
      "error_message",
      "get_principal",
      "get_resource",
      "global_search_input",
      "global_search_state",
      "invalidate_advanced_session",
      "open_aggregation",
      "register_navigation",
      "render_compact_resource_result",
      "restore_compact_result_anchor",
      "search_bar",
      "select_record_details",
      "show_authenticated_view",
      "subtitle",
      "table_container",
      "title"
    ],
    "replacements": [
      [
        "auth_state.get(\"principal\")",
        "get_principal()"
      ],
      [
        "state[\"resource\"]",
        "get_resource()"
      ],
      [
        "state.update(resource='full-text-search')",
        "enter_global_search()"
      ],
      [
        "state.pop(\"discard_navigation_guard\", None)",
        "discard_navigation_guard()"
      ],
      [
        "state.pop(\"advanced_search_workspace\", None)",
        "clear_advanced_workspace()"
      ],
      [
        "state[\"advanced_search_session_revision\"] = state.get(\"advanced_search_session_revision\", 0) + 1",
        "invalidate_advanced_session()"
      ],
      [
        "collection_state.update(entity_result_states={})",
        "clear_collection_results()"
      ]
    ]
  }
]
