# Phase 4 general/UI settings are database-owned in Administration > Settings.
# Reviewed legacy migration is required on upgrade; changes propagate within 30 seconds.
# See docs/application-settings-upgrade.md; never add those keys back here.
# Copy to .env for local development. Process environment variables override it.
DATABASE_DISPLAY_NAME="Local Development"
DATABASE_DISPLAY_NAME_AR="التطوير المحلي"
DATABASE_URL=postgresql://erms:replace-with-a-secure-password@127.0.0.1:5432/erms
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=false
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=10
# API-owned Fernet key for encrypted database application settings. Default unset.
# Use the same key on API instances for the same database; preserve it on upgrade.
# Shell environment overrides .env. Restart the API after changing this key.
# Initialize a missing local key with: python -m backend.services.api.application_settings_secret --init-local-key
# APPLICATION_SETTINGS_ENCRYPTION_KEY=
# Optional Python/OpenSSL CA-file override for local API/communications-worker TLS.
# Default unset (platform trust). Restart each sending process after changing.
# For local MailDev only, use the generated project certificate; see docs/local-tooling.md.
# SSL_CERT_FILE=/absolute/path/to/erms/.runtime/maildev/localhost.pem
CONTENT_STORAGE_BACKEND=postgresql
# General, interface, content, authentication and search policies are database settings.
# Review/apply tools/migrate_application_settings.py before upgrading services.
# Runtime setting edits converge through the API cache within 30 seconds.
WEBUI_API_URL=http://127.0.0.1:8000
WEBUI_HOST=0.0.0.0
WEBUI_PORT=8080
WEBUI_RELOAD=false
TEXT_INDEXER_ENABLED=false
CONTENT_INDEXING_MAINTENANCE_ENABLED=true
TEXT_INDEXER_API_URL=http://127.0.0.1:8000
# An empty key tells run-local-stack.sh to provision locally and load the generated file below.
TEXT_INDEXER_API_KEY=
TEXT_INDEXER_API_KEY_FILE=.secrets/text-indexer-api-key
TEXT_INDEXER_TIKA_HOME=vendor/tika
TEXT_INDEXER_CLAIM_BATCH_SIZE=1
TEXT_INDEXER_PROCESS_COUNT=2
TEXT_INDEXER_POLL_SECONDS=5
TEXT_INDEXER_HEARTBEAT_SECONDS=60
TEXT_INDEXER_EXTRACTION_TIMEOUT_SECONDS=120
TEXT_INDEXER_MAX_INPUT_BYTES=52428800
TEXT_INDEXER_MAX_EXTRACTED_CHARACTERS=5000000
TEXT_INDEXER_CHUNK_TARGET_CHARACTERS=16000
TEXT_INDEXER_CHUNK_MAX_CHARACTERS=20000
TEXT_INDEXER_MAX_PAGES=1000
TEXT_INDEXER_MAX_TEMP_BYTES=1073741824
TEXT_INDEXER_TEMP_DIR=/tmp/wathiq-text-indexer
TEXT_INDEXER_STALE_TEMP_HOURS=24
TEXT_INDEXER_TEMP_SWEEP_LIMIT=100
# API-side maintenance retention; this is not a text-indexer worker setting.
# Maximum matching events available in an Audit Trail search.

# Messaging limits are validated at startup; changing them requires a restart.
MESSAGING_MAX_SELECTORS_PER_SEND=100
MESSAGING_MAX_RECIPIENTS_PER_SEND=2000
MESSAGING_MAX_RESOURCE_LINKS=50
MESSAGING_DRAFT_ACTIVE_DAYS=180
MESSAGING_DRAFT_WARNING_DAYS=30
MESSAGING_DRAFT_RECOVERY_DAYS=30
MESSAGING_CAPTURE_MAX_LINKED_MESSAGES=100
MESSAGING_CAPTURE_MAX_PDF_BYTES=52428800
MESSAGING_RETENTION_DAYS=1095
MESSAGING_RETENTION_WARNING_DAYS=90
MESSAGING_DELETION_RECOVERY_DAYS=30
MESSAGING_CLEANUP_INTERVAL_SECONDS=3600
MESSAGING_CLEANUP_BATCH_SIZE=500
MESSAGING_TEST_MAX_RECIPIENTS=10
MESSAGING_TEST_SENDS_PER_HOUR=20
MESSAGING_TEST_RETENTION_DAYS=30

# Messaging live gateways: each API worker uses one additional direct DB connection.
# Proxies must preserve WebSocket upgrades, disable SSE buffering, and allow
# idle timeouts above the heartbeat interval. No sticky API routing is required.
MESSAGING_STREAM_MAX_CONNECTIONS=1000
MESSAGING_STREAM_MAX_USER_CONNECTIONS=20
MESSAGING_STREAM_QUEUE_SIZE=64
MESSAGING_STREAM_HEARTBEAT_SECONDS=15
MESSAGING_STREAM_SEND_TIMEOUT_SECONDS=5
# Optional direct/session-mode URL to the SAME database when DATABASE_URL uses
# a transaction-pooling proxy. Never point this at a different database.
# MESSAGING_LISTENER_DATABASE_URL=postgresql://...

# Independent PDF/A-2u and PDF/UA-1 validator; capture fails closed if unavailable.
# Local PDF validator installation kept outside Git under .local-tools/
MESSAGING_PDF_VALIDATOR=.local-tools/verapdf/verapdf

# Authentication limits; changes require an API restart.
AUTH_COOKIE_SECURE=false

# API deployment executable path; empty uses LibreOffice discovery. Restart API after changing.
LIBREOFFICE_BINARY=

# Local-development placeholder only; use a strong random secret on deployed WebUI hosts.
WEBUI_STORAGE_SECRET=local-development-change-me

# For packages without a Git checkout, supply the full application commit SHA.
# WATHIQ_APPLICATION_REVISION=<full-lowercase-commit-sha>
