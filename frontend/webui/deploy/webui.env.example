# Phase 4 general/UI settings are database-owned in Administration > Settings.
# Reviewed legacy migration is required on upgrade; changes propagate within 30 seconds.
# See docs/application-settings-upgrade.md; never add those keys back here.
# Install as /etc/erms/webui.env and replace the storage secret.
# For a remote API, use its private address or API load balancer address.
DATABASE_DISPLAY_NAME="Production Database"
DATABASE_DISPLAY_NAME_AR="قاعدة بيانات الإنتاج"
WEBUI_API_URL=http://127.0.0.1:8000
# Loopback assumes a local reverse proxy; change for a remote load balancer.
WEBUI_HOST=127.0.0.1
WEBUI_PORT=8080
WEBUI_RELOAD=false
WEBUI_STORAGE_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET
# Redis is optional. Leave unset to use local user storage.
# NICEGUI_REDIS_URL=redis://redis.internal:6379/0
# NICEGUI_REDIS_KEY_PREFIX=erms:
